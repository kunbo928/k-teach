{
  "name": "k-teach",
  "version": "1.0.0",
  "description": "Cross-platform Agent Skill and deterministic CLI for persistent teaching, Web Lessons, diagrams, and channel artifacts.",
  "type": "module",
  "bin": {
    "k-teach": "./bin/k-teach.js"
  },
  "files": [
    "README-zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md",
    "SKILL.md",
    "agents",
    "assets",
    "bin",
    "dist",
    "references",
    "schemas"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "changeset": "changeset",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "release": "npm run build && changeset publish",
    "test": "node --test tests/*.test.js",
    "test:tokens": "node scripts/verify-token-budgets.mjs",
    "benchmark:package-hash": "node scripts/hash-benchmark-package.mjs",
    "verify:release-evidence": "node scripts/verify-release-evidence.mjs",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunbo928/k-teach.git"
  },
  "homepage": "https://github.com/kunbo928/k-teach#readme",
  "bugs": {
    "url": "https://github.com/kunbo928/k-teach/issues"
  },
  "license": "MIT",
  "private": false,
  "dependencies": {
    "@inquirer/core": "^10.3.2",
    "chalk": "^5.6.2",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "sharp": "^0.35.3",
    "vite": "^8.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.1",
    "gpt-tokenizer": "3.4.0",
    "typescript": "^7.0.2"
  }
}
