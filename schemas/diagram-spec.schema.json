{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-teach.local/schemas/diagram-spec.schema.json",
  "title": "Diagram Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "description", "kind", "direction", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["flow", "relationship", "state"] },
    "direction": { "enum": ["top-to-bottom", "left-to-right"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "role": { "enum": ["start", "end", "decision", "step", "source", "artifact", "state"] }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "label": { "type": "string" }
        }
      }
    }
  }
}
