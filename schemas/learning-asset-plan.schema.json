{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-teach.local/schemas/learning-asset-plan.schema.json",
  "title": "Learning Asset Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "lesson_id", "lesson_revision", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "lesson_id": { "type": "string", "minLength": 1 },
    "lesson_revision": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "purpose", "prompt", "input_references"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["cover", "illustration", "comic", "infographic", "knowledge-card", "slides"] },
          "purpose": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "input_references": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
